<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>QR Studio — Free QR Code Generator with Logo</title>
    <meta name="description" content="Create customizable QR codes from any link and add your own logo in the center. Fast, simple, and free.">
    
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: { sans: ['Inter', 'sans-serif'] },
                    colors: {
                        brand: { 50: '#eff6ff', 100: '#dbeafe', 500: '#3b82f6', 600: '#2563eb', 900: '#1e3a8a' },
                        dark: { bg: '#0B0D10', card: '#15181D', border: '#272B33' }
                    },
                    boxShadow: { 'soft': '0 4px 20px -2px rgba(0, 0, 0, 0.05)' }
                }
            }
        }
    </script>
    
    <!-- React & ReactDOM -->
    <script src="https://unpkg.com/react@18/umd/react.production.min.js"></script>
    <script src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js"></script>
    <!-- Babel -->
    <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>
    <!-- QR Code Styling Library -->
    <script src="https://unpkg.com/qr-code-styling@1.5.0/lib/qr-code-styling.js"></script>

    <style>
        body { font-family: 'Inter', sans-serif; transition: background-color 0.3s, color 0.3s; }
        .glass-header { background: rgba(255, 255, 255, 0.8); backdrop-filter: blur(12px); border-bottom: 1px solid #E5E7EB; }
        .dark .glass-header { background: rgba(11, 13, 16, 0.8); border-bottom: 1px solid #272B33; }
        .hide-scrollbar::-webkit-scrollbar { display: none; }
        .hide-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
        .fade-in { animation: fadeIn 0.4s ease-in-out; }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(5px); } to { opacity: 1; transform: translateY(0); } }
    </style>
</head>
<body class="bg-[#F7F8FA] text-gray-900 dark:bg-dark-bg dark:text-gray-100 antialiased">
    <div id="root"></div>

    <script type="text/babel">
        const { useState, useEffect, useRef, useCallback } = React;

        // --- Utility Functions ---
        const isValidUrl = (string) => {
            try { new URL(string); return true; } catch (_) { return false; }
        };
        const normalizeUrl = (string) => {
            if (!string) return '';
            if (!/^https?:\/\//i.test(string)) return 'https://' + string;
            return string;
        };
        const getLuminance = (hex) => {
            let rgb = (hex || '#000000').replace('#', '').match(/\w\w/g)?.map(x => parseInt(x, 16)/255) || [0,0,0];
            let [r, g, b] = rgb.map(x => x <= 0.03928 ? x/12.92 : Math.pow((x+0.055)/1.055, 2.4));
            return 0.2126 * r + 0.7152 * g + 0.0722 * b;
        };
        const isContrastLow = (fg, bg) => {
            let lum1 = getLuminance(fg), lum2 = getLuminance(bg);
            let ratio = (Math.max(lum1, lum2) + 0.05) / (Math.min(lum1, lum2) + 0.05);
            return ratio < 2.5; 
        };
        const formatFilename = (url) => {
            try { return `qr-studio-${new URL(url).hostname.replace('www.', '')}`; } 
            catch { return `qr-studio-${Date.now()}`; }
        };

        // --- Shape Cropping for Logo ---
        const processLogoShape = (dataUrl, shape) => {
            return new Promise((resolve) => {
                if (shape === 'square') { resolve(dataUrl); return; }
                const img = new Image();
                img.onload = () => {
                    const canvas = document.createElement('canvas');
                    const size = Math.min(img.width, img.height);
                    canvas.width = size; canvas.height = size;
                    const ctx = canvas.getContext('2d');
                    ctx.beginPath();
                    if (shape === 'circle') {
                        ctx.arc(size/2, size/2, size/2, 0, Math.PI * 2);
                    } else if (shape === 'rounded') {
                        const radius = size * 0.25;
                        ctx.moveTo(radius, 0); ctx.arcTo(size, 0, size, size, radius);
                        ctx.arcTo(size, size, 0, size, radius); ctx.arcTo(0, size, 0, 0, radius);
                        ctx.arcTo(0, 0, size, 0, radius); ctx.closePath();
                    }
                    ctx.clip();
                    const dx = (size - img.width) / 2;
                    const dy = (size - img.height) / 2;
                    ctx.drawImage(img, dx, dy);
                    resolve(canvas.toDataURL('image/png'));
                };
                img.src = dataUrl;
            });
        };

        // --- SVGs Icons Component ---
        const Icon = ({ name, size=20, className="" }) => {
            const icons = {
                link: <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>,
                upload: <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M17 8l-5-5-5 5M12 3v12"/>,
                check: <path d="M20 6L9 17l-5-5"/>,
                copy: <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>,
                moon: <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>,
                sun: <circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>,
                trash: <path d="M3 6h18M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>,
                download: <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3"/>,
                qr: <rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect>,
                warn: <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0zM12 9v4M12 17h.01"/>
            };
            return (
                <svg xmlns="http://www.w3.org/2000/svg" width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" className={className}>
                    {icons[name]}
                </svg>
            );
        };

        // --- Main App Component ---
        const App = () => {
            const [theme, setTheme] = useState('light');
            
            // State: URL & Validation
            const [rawUrl, setRawUrl] = useState('');
            const url = normalizeUrl(rawUrl);
            const isValid = rawUrl.length > 0 ? isValidUrl(url) : false;

            // State: Logo
            const [logo, setLogo] = useState(null);
            const [logoFile, setLogoFile] = useState(null);
            const [processedLogo, setProcessedLogo] = useState(null);
            
            // State: Customization
            const [logoSize, setLogoSize] = useState(0.2); // 10% - 30%
            const [logoShape, setLogoShape] = useState('rounded'); // square, rounded, circle
            const [qrColor, setQrColor] = useState('#111827');
            const [bgColor, setBgColor] = useState('#FFFFFF');
            const [moduleStyle, setModuleStyle] = useState('square'); // square, rounded, dots
            const [finderStyle, setFinderStyle] = useState('square'); // square, extra-rounded
            
            const [toast, setToast] = useState('');
            const qrRef = useRef(null);
            const qrCodeInstance = useRef(null);

            // Toggle Dark Mode
            useEffect(() => {
                if (theme === 'dark') document.documentElement.classList.add('dark');
                else document.documentElement.classList.remove('dark');
            }, [theme]);

            const toggleTheme = () => setTheme(t => t === 'light' ? 'dark' : 'light');
            const showToast = (msg) => { setToast(msg); setTimeout(() => setToast(''), 3000); };

            // Process Logo Shape
            useEffect(() => {
                if (logo) {
                    processLogoShape(logo, logoShape).then(setProcessedLogo);
                } else {
                    setProcessedLogo(null);
                }
            }, [logo, logoShape]);

            // Initialize & Update QR Code
            useEffect(() => {
                if (!qrCodeInstance.current) {
                    qrCodeInstance.current = new QRCodeStyling({
                        width: 320, height: 320, margin: 16, type: 'svg',
                        qrOptions: { errorCorrectionLevel: 'H' }
                    });
                }
                
                qrCodeInstance.current.update({
                    data: isValid ? url : 'https://qrstudio.app',
                    image: processedLogo || undefined,
                    dotsOptions: { color: qrColor, type: moduleStyle },
                    backgroundOptions: { color: bgColor },
                    cornersSquareOptions: { color: qrColor, type: finderStyle },
                    cornersDotOptions: { color: qrColor, type: finderStyle === 'extra-rounded' ? 'dot' : 'square' },
                    imageOptions: { hideBackgroundDots: true, imageSize: logoSize, margin: 8 }
                });

                if (qrRef.current) {
                    qrRef.current.innerHTML = '';
                    qrCodeInstance.current.append(qrRef.current);
                }
            }, [url, isValid, processedLogo, logoSize, qrColor, bgColor, moduleStyle, finderStyle]);

            // Handlers
            const handlePaste = async () => {
                try {
                    const text = await navigator.clipboard.readText();
                    setRawUrl(text);
                } catch (e) { showToast('Clipboard access denied.'); }
            };

            const handleLogoUpload = (e) => {
                const file = e.target.files[0];
                if (!file) return;
                if (file.size > 5 * 1024 * 1024) { showToast('File is too large. Max 5MB.'); return; }
                if (!['image/png', 'image/jpeg', 'image/svg+xml'].includes(file.type)) { showToast('Unsupported format.'); return; }
                
                setLogoFile(file);
                const reader = new FileReader();
                reader.onload = (event) => setLogo(event.target.result);
                reader.readAsDataURL(file);
            };

            const removeLogo = () => { setLogo(null); setLogoFile(null); setProcessedLogo(null); };

            const handleReset = () => {
                setRawUrl(''); removeLogo(); setLogoSize(0.2); setLogoShape('rounded');
                setQrColor('#111827'); setBgColor('#FFFFFF'); setModuleStyle('square'); setFinderStyle('square');
                showToast('Reset successful');
            };

            const downloadQR = (ext) => {
                if (!isValid) { showToast('Please enter a valid URL first.'); return; }
                qrCodeInstance.current.download({ name: formatFilename(url), extension: ext });
                showToast(`QR Code downloaded as ${ext.toUpperCase()}`);
            };

            return (
                <div className="min-h-screen flex flex-col font-sans">
                    {/* Header */}
                    <header className="glass-header sticky top-0 z-50 transition-colors duration-300">
                        <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
                            <div className="flex items-center gap-2 font-bold text-xl tracking-tight text-gray-900 dark:text-white">
                                <div className="bg-brand-600 text-white p-1.5 rounded-lg"><Icon name="qr" size={24}/></div>
                                QR Studio
                            </div>
                            <nav className="hidden md:flex gap-6 text-sm font-medium text-gray-600 dark:text-gray-300">
                                <a href="#generator" className="hover:text-brand-600 transition">Generator</a>
                                <a href="#features" className="hover:text-brand-600 transition">Features</a>
                                <a href="#how-it-works" className="hover:text-brand-600 transition">How it Works</a>
                            </nav>
                            <div className="flex items-center gap-4">
                                <button onClick={toggleTheme} className="p-2 rounded-full hover:bg-gray-100 dark:hover:bg-gray-800 text-gray-600 dark:text-gray-300 transition">
                                    {theme === 'light' ? <Icon name="moon" /> : <Icon name="sun" />}
                                </button>
                                <a href="#generator" className="bg-brand-600 hover:bg-brand-700 text-white text-sm font-medium px-4 py-2 rounded-full transition shadow-sm">
                                    Get Started
                                </a>
                            </div>
                        </div>
                    </header>

                    <main className="flex-grow">
                        {/* Hero */}
                        <section className="pt-20 pb-16 px-4 text-center relative overflow-hidden">
                            <div className="absolute inset-0 z-0 opacity-[0.03] dark:opacity-[0.05] flex items-center justify-center pointer-events-none">
                                <svg width="600" height="600" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
                                    <path d="M3 3h8v8H3V3zm2 2v4h4V5H5zm8-2h8v8h-8V3zm2 2v4h4V5h-4zM3 13h8v8H3v-8zm2 2v4h4v-4H5zm13-2h3v3h-3v-3zm-3 3h3v3h-3v-3zm3 3h3v3h-3v-3zm-3 3h3v3h-3v-3z"/>
                                </svg>
                            </div>
                            <div className="max-w-3xl mx-auto relative z-10 fade-in">
                                <p className="text-brand-600 font-semibold tracking-wider text-xs uppercase mb-3">QR Code Generator</p>
                                <h1 className="text-4xl md:text-5xl font-bold tracking-tight text-gray-900 dark:text-white mb-6">
                                    Create beautiful QR codes <br className="hidden md:block" /> from your links.
                                </h1>
                                <p className="text-lg text-gray-600 dark:text-gray-400 mb-8 max-w-xl mx-auto">
                                    Generate customizable QR codes and place your logo right in the center. Fast, private, and works entirely in your browser.
                                </p>
                                <p className="text-sm font-medium text-gray-500 dark:text-gray-500">
                                    Fast &nbsp;&bull;&nbsp; Private &nbsp;&bull;&nbsp; No sign-up required
                                </p>
                            </div>
                        </section>

                        {/* Workspace Grid */}
                        <section id="generator" className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-24">
                            <div className="grid grid-cols-1 lg:grid-cols-12 gap-8">
                                
                                {/* Left Column: Control Panel */}
                                <div className="lg:col-span-5 space-y-6">
                                    {/* URL Card */}
                                    <div className="bg-white dark:bg-dark-card p-6 rounded-2xl shadow-soft border border-gray-200 dark:border-dark-border">
                                        <label className="block text-sm font-semibold mb-2 dark:text-white">Your Link</label>
                                        <div className="relative flex items-center">
                                            <div className="absolute left-3 text-gray-400"><Icon name="link" size={18}/></div>
                                            <input 
                                                type="url" 
                                                placeholder="https://example.com"
                                                value={rawUrl}
                                                onChange={(e) => setRawUrl(e.target.value)}
                                                className={`w-full pl-10 pr-24 py-3 bg-gray-50 dark:bg-[#1A1D24] border rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 transition dark:text-white ${rawUrl.length > 0 && !isValid ? 'border-red-500' : 'border-gray-200 dark:border-gray-700'}`}
                                            />
                                            <div className="absolute right-2 flex items-center gap-1">
                                                {isValid && <div className="text-green-500 mr-2"><Icon name="check" size={18}/></div>}
                                                <button onClick={handlePaste} className="text-xs bg-gray-200 dark:bg-gray-700 hover:bg-gray-300 dark:hover:bg-gray-600 text-gray-700 dark:text-gray-200 px-3 py-1.5 rounded-lg font-medium transition">
                                                    Paste
                                                </button>
                                            </div>
                                        </div>
                                        {rawUrl.length > 0 && !isValid && <p className="text-red-500 text-xs mt-2">Please enter a valid URL.</p>}
                                    </div>

                                    {/* Logo Card */}
                                    <div className="bg-white dark:bg-dark-card p-6 rounded-2xl shadow-soft border border-gray-200 dark:border-dark-border">
                                        <div className="flex justify-between items-center mb-4">
                                            <label className="block text-sm font-semibold dark:text-white">Center Logo</label>
                                            {logo && <button onClick={removeLogo} className="text-xs text-red-500 hover:text-red-600 font-medium flex items-center gap-1"><Icon name="trash" size={14}/> Remove</button>}
                                        </div>
                                        
                                        {!logo ? (
                                            <div className="border-2 border-dashed border-gray-300 dark:border-gray-700 rounded-xl p-8 text-center hover:border-brand-500 dark:hover:border-brand-500 transition relative group cursor-pointer">
                                                <input type="file" accept=".png,.jpg,.jpeg,.svg" onChange={handleLogoUpload} className="absolute inset-0 w-full h-full opacity-0 cursor-pointer z-10" />
                                                <div className="text-gray-400 group-hover:text-brand-500 flex flex-col items-center gap-2 transition">
                                                    <Icon name="upload" size={28}/>
                                                    <div>
                                                        <p className="text-sm font-medium text-gray-700 dark:text-gray-300">Drag & drop or browse</p>
                                                        <p className="text-xs text-gray-500 mt-1">PNG, JPG or SVG (Max 5MB)</p>
                                                    </div>
                                                </div>
                                            </div>
                                        ) : (
                                            <div className="space-y-4">
                                                <div className="flex items-center gap-4 bg-gray-50 dark:bg-[#1A1D24] p-3 rounded-xl border border-gray-200 dark:border-gray-700">
                                                    <img src={processedLogo || logo} alt="Logo preview" className="w-12 h-12 object-contain bg-white rounded-md border border-gray-200 p-1" />
                                                    <div className="flex-1 overflow-hidden">
                                                        <p className="text-sm font-medium truncate dark:text-white">{logoFile?.name || 'Uploaded Logo'}</p>
                                                        <p className="text-xs text-gray-500">{(logoFile?.size / 1024).toFixed(0)} KB</p>
                                                    </div>
                                                </div>
                                                
                                                <div className="space-y-3">
                                                    <div>
                                                        <div className="flex justify-between text-xs mb-1 dark:text-gray-400">
                                                            <span>Logo Size</span>
                                                            <span>{Math.round(logoSize * 100)}%</span>
                                                        </div>
                                                        <input type="range" min="0.1" max="0.3" step="0.01" value={logoSize} onChange={(e)=>setLogoSize(parseFloat(e.target.value))} className="w-full h-1.5 bg-gray-200 rounded-lg appearance-none cursor-pointer accent-brand-600"/>
                                                    </div>
                                                    <div>
                                                        <span className="text-xs text-gray-500 dark:text-gray-400 block mb-2">Logo Shape</span>
                                                        <div className="flex gap-2">
                                                            {['square', 'rounded', 'circle'].map(s => (
                                                                <button key={s} onClick={()=>setLogoShape(s)} className={`flex-1 py-1.5 text-xs font-medium rounded-lg border transition capitalize ${logoShape === s ? 'bg-brand-50 border-brand-500 text-brand-700 dark:bg-brand-900/30 dark:border-brand-500 dark:text-brand-300' : 'border-gray-200 text-gray-600 hover:bg-gray-50 dark:border-gray-700 dark:text-gray-400 dark:hover:bg-gray-800'}`}>
                                                                    {s}
                                                                </button>
                                                            ))}
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        )}
                                    </div>

                                    {/* Appearance Card */}
                                    <div className="bg-white dark:bg-dark-card p-6 rounded-2xl shadow-soft border border-gray-200 dark:border-dark-border space-y-5">
                                        <label className="block text-sm font-semibold dark:text-white">Appearance</label>
                                        
                                        <div className="grid grid-cols-2 gap-4">
                                            <div>
                                                <span className="text-xs text-gray-500 block mb-1">QR Color</span>
                                                <div className="flex items-center gap-2">
                                                    <input type="color" value={qrColor} onChange={(e)=>setQrColor(e.target.value)} className="w-8 h-8 rounded cursor-pointer border-0 p-0" />
                                                    <span className="text-xs uppercase font-medium dark:text-gray-300">{qrColor}</span>
                                                </div>
                                            </div>
                                            <div>
                                                <span className="text-xs text-gray-500 block mb-1">Background</span>
                                                <div className="flex items-center gap-2">
                                                    <input type="color" value={bgColor} onChange={(e)=>setBgColor(e.target.value)} className="w-8 h-8 rounded cursor-pointer border-0 p-0" />
                                                    <span className="text-xs uppercase font-medium dark:text-gray-300">{bgColor}</span>
                                                </div>
                                            </div>
                                        </div>

                                        {isContrastLow(qrColor, bgColor) && (
                                            <div className="flex items-start gap-2 bg-yellow-50 dark:bg-yellow-900/20 text-yellow-700 dark:text-yellow-500 p-3 rounded-lg text-xs font-medium">
                                                <Icon name="warn" size={16} className="shrink-0 mt-0.5"/>
                                                Low contrast may make your QR code difficult to scan.
                                            </div>
                                        )}

                                        <div>
                                            <span className="text-xs text-gray-500 block mb-2">Module Style</span>
                                            <div className="flex gap-2">
                                                {['square', 'rounded', 'dots'].map(s => (
                                                    <button key={s} onClick={()=>setModuleStyle(s)} className={`flex-1 py-1.5 text-xs font-medium rounded-lg border transition capitalize ${moduleStyle === s ? 'bg-brand-50 border-brand-500 text-brand-700 dark:bg-brand-900/30 dark:border-brand-500 dark:text-brand-300' : 'border-gray-200 text-gray-600 hover:bg-gray-50 dark:border-gray-700 dark:text-gray-400 dark:hover:bg-gray-800'}`}>
                                                        {s}
                                                    </button>
                                                ))}
                                            </div>
                                        </div>
                                        <div>
                                            <span className="text-xs text-gray-500 block mb-2">Eye Style</span>
                                            <div className="flex gap-2">
                                                {['square', 'extra-rounded'].map((s,i) => (
                                                    <button key={s} onClick={()=>setFinderStyle(s)} className={`flex-1 py-1.5 text-xs font-medium rounded-lg border transition ${finderStyle === s ? 'bg-brand-50 border-brand-500 text-brand-700 dark:bg-brand-900/30 dark:border-brand-500 dark:text-brand-300' : 'border-gray-200 text-gray-600 hover:bg-gray-50 dark:border-gray-700 dark:text-gray-400 dark:hover:bg-gray-800'}`}>
                                                        {i === 0 ? 'Square' : 'Rounded'}
                                                    </button>
                                                ))}
                                            </div>
                                        </div>
                                        
                                        <button onClick={handleReset} className="w-full py-2 mt-2 text-sm text-gray-500 hover:text-gray-800 dark:hover:text-white font-medium transition">
                                            Reset to defaults
                                        </button>
                                    </div>
                                </div>

                                {/* Right Column: Preview & Actions */}
                                <div className="lg:col-span-7">
                                    <div className="sticky top-24">
                                        <div className="bg-white dark:bg-dark-card p-6 md:p-10 rounded-[24px] shadow-soft border border-gray-200 dark:border-dark-border text-center flex flex-col items-center">
                                            <h2 className="text-xl font-bold mb-6 dark:text-white">Your QR Code</h2>
                                            
                                            {/* QR Preview Area - Always white background inside to ensure scanning */}
                                            <div className="bg-white p-4 md:p-6 rounded-2xl shadow-sm border border-gray-100 relative group overflow-hidden">
                                                {!isValid && rawUrl.length === 0 ? (
                                                    <div className="w-[280px] h-[280px] md:w-[320px] md:h-[320px] bg-gray-50 rounded-xl flex flex-col items-center justify-center text-gray-400 border border-dashed border-gray-200">
                                                        <Icon name="qr" size={48} className="mb-4 opacity-50"/>
                                                        <p className="text-sm font-medium">Your QR code will appear here</p>
                                                        <p className="text-xs mt-1">Enter a URL to get started.</p>
                                                    </div>
                                                ) : (
                                                    <div className={`w-[280px] h-[280px] md:w-[320px] md:h-[320px] flex items-center justify-center transition-opacity duration-300 ${!isValid ? 'opacity-30' : 'opacity-100'}`} ref={qrRef}></div>
                                                )}
                                            </div>

                                            {isValid && (
                                                <div className="mt-6 flex items-center justify-center gap-2 text-sm text-gray-600 dark:text-gray-400 fade-in">
                                                    <span className="truncate max-w-[200px]">{url}</span>
                                                    <button onClick={() => {navigator.clipboard.writeText(url); showToast('Copied!');}} className="p-1.5 hover:bg-gray-100 dark:hover:bg-gray-800 rounded transition" title="Copy URL">
                                                        <Icon name="copy" size={16}/>
                                                    </button>
                                                </div>
                                            )}

                                            <div className="w-full mt-8 flex flex-col sm:flex-row gap-3">
                                                <button 
                                                    onClick={() => downloadQR('png')} 
                                                    disabled={!isValid}
                                                    className={`flex-1 flex justify-center items-center gap-2 py-3.5 px-4 rounded-xl font-semibold text-sm transition-all ${isValid ? 'bg-brand-600 hover:bg-brand-700 text-white shadow-md' : 'bg-gray-100 text-gray-400 cursor-not-allowed dark:bg-gray-800 dark:text-gray-600'}`}
                                                >
                                                    <Icon name="download" size={18}/> Download PNG
                                                </button>
                                                <button 
                                                    onClick={() => downloadQR('svg')} 
                                                    disabled={!isValid}
                                                    className={`flex-1 flex justify-center items-center gap-2 py-3.5 px-4 rounded-xl font-semibold text-sm transition-all ${isValid ? 'bg-white border-2 border-gray-200 hover:border-gray-300 text-gray-700 shadow-sm dark:bg-[#1A1D24] dark:border-gray-700 dark:text-white dark:hover:border-gray-500' : 'bg-transparent border-2 border-gray-100 text-gray-300 cursor-not-allowed dark:border-gray-800 dark:text-gray-700'}`}
                                                >
                                                    Download SVG
                                                </button>
                                            </div>
                                            <p className="text-xs text-gray-400 mt-4">Downloads in high resolution (1024px)</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </section>

                        {/* Features */}
                        <section id="features" className="py-20 bg-white dark:bg-dark-card border-y border-gray-100 dark:border-dark-border">
                            <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                                <div className="text-center mb-12">
                                    <h2 className="text-3xl font-bold text-gray-900 dark:text-white mb-4">Everything you need to create better QR codes.</h2>
                                </div>
                                <div className="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
                                    {[{
                                        title: 'Custom Logo',
                                        desc: 'Place your own logo directly in the center of your QR code.',
                                        icon: <svg className="w-6 h-6 text-brand-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                                    }, {
                                        title: 'High Resolution',
                                        desc: 'Export sharp QR codes for digital and print use (PNG & SVG).',
                                        icon: <svg className="w-6 h-6 text-brand-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7"></path></svg>
                                    }, {
                                        title: 'Easy Customization',
                                        desc: 'Change colors, logo size, and QR appearance in seconds.',
                                        icon: <svg className="w-6 h-6 text-brand-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"></path></svg>
                                    }, {
                                        title: 'Private by Design',
                                        desc: 'Your QR generation happens directly in your browser. No data uploaded.',
                                        icon: <svg className="w-6 h-6 text-brand-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>
                                    }].map((f, i) => (
                                        <div key={i} className="bg-gray-50 dark:bg-[#1A1D24] p-6 rounded-2xl border border-gray-100 dark:border-gray-800">
                                            <div className="bg-white dark:bg-gray-800 w-12 h-12 rounded-xl flex items-center justify-center shadow-sm mb-4">
                                                {f.icon}
                                            </div>
                                            <h3 className="font-semibold text-gray-900 dark:text-white mb-2">{f.title}</h3>
                                            <p className="text-sm text-gray-600 dark:text-gray-400 leading-relaxed">{f.desc}</p>
                                        </div>
                                    ))}
                                </div>
                            </div>
                        </section>

                        {/* How it Works */}
                        <section id="how-it-works" className="py-20">
                            <div className="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
                                <h2 className="text-3xl font-bold text-center text-gray-900 dark:text-white mb-12">Create your QR code in three simple steps.</h2>
                                <div className="flex flex-col md:flex-row gap-8 relative">
                                    <div className="hidden md:block absolute top-12 left-10 right-10 h-0.5 bg-gray-200 dark:bg-gray-800 z-0"></div>
                                    {[{
                                        step: '01', title: 'Paste your link', desc: 'Enter the URL you want to convert into a QR code.'
                                    }, {
                                        step: '02', title: 'Add your logo', desc: 'Upload your logo and position it in the center.'
                                    }, {
                                        step: '03', title: 'Download', desc: 'Generate your QR code and download it instantly.'
                                    }].map((s, i) => (
                                        <div key={i} className="flex-1 text-center relative z-10">
                                            <div className="w-12 h-12 bg-brand-600 text-white rounded-full flex items-center justify-center font-bold text-lg mx-auto mb-6 shadow-md border-4 border-[#F7F8FA] dark:border-dark-bg">
                                                {s.step}
                                            </div>
                                            <h3 className="text-lg font-semibold text-gray-900 dark:text-white mb-2">{s.title}</h3>
                                            <p className="text-sm text-gray-600 dark:text-gray-400">{s.desc}</p>
                                        </div>
                                    ))}
                                </div>
                            </div>
                        </section>

                        {/* FAQ */}
                        <section className="py-20 bg-white dark:bg-dark-card border-t border-gray-100 dark:border-dark-border">
                            <div className="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
                                <h2 className="text-2xl font-bold text-center text-gray-900 dark:text-white mb-10">Frequently Asked Questions</h2>
                                <div className="space-y-6">
                                    {[{
                                        q: 'Can I use any URL?', a: 'Yes. You can generate QR codes for any valid web URL, including social media profiles, Google Drive links, and personal websites.'
                                    }, {
                                        q: 'Can I add my own logo?', a: 'Yes. You can upload your logo in PNG, JPG, or SVG format. The app will automatically place it perfectly in the center.'
                                    }, {
                                        q: 'Will the QR code still scan with a logo?', a: 'Yes, the generator uses a High (H) error correction level and limits the logo size to maximum 30% to help preserve scanability.'
                                    }, {
                                        q: 'Do I need an account?', a: 'No. The QR generator is completely free and does not require an account.'
                                    }, {
                                        q: 'Can I print the QR code?', a: 'Absolutely. We recommend downloading the SVG format or the high-resolution PNG format, both of which are suitable for crisp, professional printing.'
                                    }].map((faq, i) => (
                                        <div key={i} className="bg-gray-50 dark:bg-[#1A1D24] rounded-xl p-6">
                                            <h4 className="font-semibold text-gray-900 dark:text-white mb-2">{faq.q}</h4>
                                            <p className="text-sm text-gray-600 dark:text-gray-400">{faq.a}</p>
                                        </div>
                                    ))}
                                </div>
                            </div>
                        </section>
                    </main>

                    {/* Footer */}
                    <footer className="border-t border-gray-200 dark:border-dark-border bg-white dark:bg-dark-card pt-12 pb-8">
                        <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row justify-between items-center gap-6">
                            <div>
                                <div className="flex items-center gap-2 font-bold text-lg text-gray-900 dark:text-white mb-2">
                                    <div className="bg-gray-200 dark:bg-gray-700 text-gray-700 dark:text-gray-200 p-1 rounded-md"><Icon name="qr" size={18}/></div>
                                    QR Studio
                                </div>
                                <p className="text-sm text-gray-500">Create beautiful QR codes from your links.</p>
                            </div>
                            <div className="flex gap-6 text-sm font-medium text-gray-500">
                                <a href="#generator" className="hover:text-brand-600 transition">Generator</a>
                                <a href="#features" className="hover:text-brand-600 transition">Features</a>
                            </div>
                        </div>
                        <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-12 flex flex-col md:flex-row justify-between items-center text-xs text-gray-400">
                            <p>&copy; 2026 QR Studio. All rights reserved.</p>
                            <p className="mt-2 md:mt-0 flex items-center gap-1">Made for creators.</p>
                        </div>
                    </footer>

                    {/* Toast Notification */}
                    {toast && (
                        <div className="fixed bottom-6 left-1/2 transform -translate-x-1/2 bg-gray-900 text-white dark:bg-white dark:text-gray-900 px-6 py-3 rounded-full text-sm font-medium shadow-xl fade-in z-50">
                            {toast}
                        </div>
                    )}
                </div>
            );
        };

        const root = ReactDOM.createRoot(document.getElementById('root'));
        root.render(<App />);
    </script>
</body>
</html>
